    "spec:check": ".bin/spec-spine compile && .bin/spec-spine index check && .bin/spec-spine lint --fail-on-warn"
  },
  "devDependencies": {},
  "tenant-tail": {
    "spec": "000-tenant-tail-bootstrap"
  }
}
